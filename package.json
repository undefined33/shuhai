{
  "name": "shuhai",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chrome bookmark organizer and reviewed X-to-Obsidian sync tool",
  "author": "ShuHai Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/host-command/assert-session.cjs root-preinstall-raw",
    "prepare": "node scripts/host-command/assert-session.cjs root-prepare-raw",
    "dev": "node scripts/host-command/shuhai-command.cjs root-dev",
    "build": "node scripts/host-command/shuhai-command.cjs root-build",
    "test": "node scripts/host-command/shuhai-command.cjs root-test",
    "test:coverage": "node scripts/host-command/shuhai-command.cjs root-test-coverage",
    "test:e2e": "node scripts/host-command/shuhai-command.cjs root-test-e2e",
    "dogfood:create": "node scripts/host-command/shuhai-command.cjs dogfood-create",
    "dogfood:verify": "node scripts/host-command/shuhai-command.cjs dogfood-verify",
    "dogfood:verify-accepted": "node scripts/host-command/shuhai-command.cjs dogfood-verify-accepted",
    "dogfood:accept": "node scripts/host-command/shuhai-command.cjs dogfood-accept",
    "lint": "node scripts/host-command/shuhai-command.cjs root-lint",
    "typecheck": "node scripts/host-command/shuhai-command.cjs root-typecheck",
    "clean": "node scripts/host-command/shuhai-command.cjs blocked-clean"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@playwright/test": "1.60.0",
    "@types/node": "22.15.21",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "globals": "16.1.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript-eslint": "8.32.1",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "openai": "6.38.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "node scripts/host-command/assert-session.cjs lint-staged-ts-raw"
    ],
    "*.{json,md,yml,yaml}": [
      "node scripts/host-command/assert-session.cjs lint-staged-docs-raw"
    ]
  }
}
