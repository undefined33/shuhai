    "clean": "node ../../scripts/host-command/shuhai-command.cjs blocked-clean",
    "_shuhai:dev": "node ../../scripts/host-command/assert-session.cjs shared-dev-raw",
    "_shuhai:build": "node ../../scripts/host-command/assert-session.cjs shared-build-raw",
    "_shuhai:test": "node ../../scripts/host-command/assert-session.cjs shared-test-raw",
    "_shuhai:lint": "node ../../scripts/host-command/assert-session.cjs shared-lint-raw",
