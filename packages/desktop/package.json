{
  "name": "@shuhai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "electron ./dist/main/index.js",
    "start": "electron ./dist/main/index.js",
    "build": "tsc && vite build",
    "test": "vitest run --root .",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@shuhai/shared": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.4.1",
    "electron": "41.6.1",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
