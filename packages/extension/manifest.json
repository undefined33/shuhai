{
  "manifest_version": 3,
  "name": "ShuHai Bookmark Organizer",
  "version": "0.1.0",
  "description": "Organize Chrome bookmarks with local rules and optional AI review.",
  "permissions": ["bookmarks", "storage", "contextMenus", "sidePanel", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://weibo.com/*", "https://m.weibo.cn/*"],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "ShuHai"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://weibo.com/*", "https://m.weibo.cn/*"],
      "js": ["content/weibo.js"],
      "run_at": "document_idle"
    }
  ]
}
